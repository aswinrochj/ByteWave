rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow users to upload files if they are authenticated
      // And they only upload to a folder named after their UID
      match /users/{userId}/{fileName} {
        allow read: if true; // Publicly readable if you want, or change to: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Default: Deny all
      allow read, write: if false;
    }
  }
}
